# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example (this file) is committed so the shape of the config is documented.

DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=salonos_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# "console" logs/prints outbound messages instead of calling a real API —
# see apps/messaging/providers.py. Only value that exists for now.
MESSAGING_PROVIDER=console
